# Copy to .env.server. Never commit or paste real values in chat.
# In Atlas: Connect > Drivers > Node.js. URL-encode password special characters.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DB=bluebook
# Your separate workspace login password, not your MongoDB password.
APP_PASSWORD=YOUR_WORKSPACE_PASSWORD

# Generate a long random value and keep it stable across restarts.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Exact website URL. Local Vite origin during development:
PUBLIC_ORIGIN=http://localhost:5173
PORT=3001
# Set NODE_ENV=production and PUBLIC_ORIGIN=https://your-website on hosting.

