# Copy these settings into .env.local when ready to switch from MongoDB.
VITE_STORAGE_MODE=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy anon keys also work as VITE_SUPABASE_ANON_KEY.
# Never use a service_role / sb_secret_ key here.
